# =====================================================================
# Copie para .env e preencha. NUNCA versione o .env.
# =====================================================================

# --- API ---
PORT=3000
# Porta publicada no host (mude se a 3000 já estiver em uso)
API_PORT=3001
# URL pública da API. Em produção use HTTPS (ex.: https://api.suabarbearia.com.br)
PUBLIC_API_URL=http://localhost:3001
# Origens permitidas no CORS, separadas por vírgula (vazio = todas)
CORS_ORIGINS=

# --- Banco / Redis ---
POSTGRES_USER=barber
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=barbearia
DATABASE_URL=postgresql://barber:troque-esta-senha@postgres:5432/barbearia?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=troque-esta-senha-redis

# --- Segurança ---
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# 32 bytes em base64 (criptografa tokens das instâncias). Gere com: openssl rand -base64 32
# NÃO troque depois de criar barbearias: os tokens já salvos deixariam de abrir.
ENCRYPTION_KEY=

# --- Evolution Go (WhatsApp) — interno, nunca exposto às barbearias ---
EVOLUTION_API_URL=http://evolution:8080
# Gere com: openssl rand -hex 32
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_WEBHOOK_EVENTS=MESSAGE,CONNECTION,QRCODE
# Webhooks do Evolution chegam na API pela rede interna do Docker:
EVOLUTION_WEBHOOK_BASE=http://api:3000
# Intervalo entre mensagens de campanha (anti-bloqueio)
WHATSAPP_SEND_INTERVAL_MS=1500

# --- Mensalidade da plataforma (cobrança manual) ---
PLATFORM_PRICE_CENTS=20000
TRIAL_DAYS=7
GRACE_DAYS=3
# Sua chave PIX, exibida no app do dono da barbearia
PLATFORM_PIX_KEY=
# Texto exibido na tela de assinatura
PLATFORM_PAYMENT_INSTRUCTIONS=Pague a mensalidade via PIX e envie o comprovante pelo WhatsApp. A confirmação é feita em até 1 dia útil.
# Seu WhatsApp (só números, com DDI) para o botão "Enviar comprovante"
PLATFORM_CONTACT=

# --- Seed (docker compose --profile tools run --rm seed) ---
SUPER_ADMIN_EMAIL=voce@seudominio.com
SUPER_ADMIN_PASSWORD=
# true cria a "Barbearia Demo" (dono@demo.com / joao@demo.com, senha demo12345)
SEED_DEMO=false
